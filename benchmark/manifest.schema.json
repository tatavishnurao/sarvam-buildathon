{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shorts Fidelity Judge manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["video_id", "creator", "source_url", "target_language", "source_transcript"],
  "properties": {
    "video_id": {"type": "string", "minLength": 1},
    "creator": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "target_language": {"type": "string", "minLength": 2},
    "source_transcript": {"type": "string", "description": "Local UTF-8 transcript path"},
    "dubbed_wav": {"type": "string", "description": "Local WAV path; optional only for transcript-only review"},
    "target_transcript": {"type": "string", "description": "Optional local manual transcript JSON path"},
    "stt": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "model": {"type": "string"}}}
  }
}
